(
    id: "elder",
    speaker_name: "Elder",
    start: "root",
    nodes: {
        // ============================================================
        // ROOT — динамическая точка входа
        // ============================================================
        "root": (
            speaker: "Elder",
            text: "Приветствую тебя, путник. Я — старейшина этой деревни. Чем могу помочь?",
            options: [
                (text: "Расскажи о деревне.", next: Some("lore_village"), effect: []),
                (text: "Есть работа?", next: Some("quest_hub"), effect: []),
                (text: "Что ты знаешь о цитадели?", next: Some("lore_citadel"), effect: []),
                (text: "Мне нужно идти.", next: None, effect: []),
            ],
        ),

        // ============================================================
        // LORE: деревня
        // ============================================================
        "lore_village": (
            speaker: "Elder",
            text: "Когда-то это была цветущая деревня. Теперь — лишь тень былого. Волки, разбойники и нежить терзают наши земли.",
            options: [
                (text: "Кто в этом виноват?", next: Some("lore_blame"), effect: []),
                (text: "Что мне сделать, чтобы помочь?", next: Some("quest_hub"), effect: []),
                (text: "Понятно.", next: Some("root"), effect: []),
            ],
        ),
        "lore_blame": (
            speaker: "Elder",
            text: "Владыка Цитадели. Он пробудился три луны назад, и с тех пор тьма расползлась по округе.",
            options: [
                (text: "Как его победить?", next: Some("lore_citadel"), effect: []),
                (text: "Я помогу.", next: Some("quest_hub"), effect: []),
                (text: "Мне жаль.", next: Some("root"), effect: []),
            ],
        ),

        // ============================================================
        // LORE: цитадель
        // ============================================================
        "lore_citadel": (
            speaker: "Elder",
            text: "Цитадель стоит на востоке. В её подземельях — Владыка. Говорят, его сердце — кристалл чистой тьмы.",
            options: [
                (text: "Как туда попасть?", next: Some("lore_path"), effect: []),
                (text: "Что мне нужно взять с собой?", next: Some("lore_gear"), effect: []),
                (text: "Я готов рискнуть.", next: Some("quest_hub"), effect: []),
                (text: "Вернусь позже.", next: Some("root"), effect: []),
            ],
        ),
        "lore_path": (
            speaker: "Elder",
            text: "Через лес — к воротам. Но они заперты. Ключ — у босса в подземелье. Или у кузнеца есть портал.",
            options: [
                (text: "Понял. Спасибо.", next: Some("root"), effect: []),
                (text: "А кто такой кузнец?", next: Some("lore_smith"), effect: []),
            ],
        ),
        "lore_smith": (
            speaker: "Elder",
            text: "Кузнец — старый друг. Он выковал оружие для многих героев. Поговори с ним перед походом.",
            options: [
                (text: "Хорошо, зайду к нему.", next: Some("root"), effect: []),
                (text: "Спасибо за совет.", next: None, effect: []),
            ],
        ),
        "lore_gear": (
            speaker: "Elder",
            text: "Возьми зелья, патроны, и не забудь про удачу — она спасает в тёмных коридорах. Держи немного золота на первое время.",
            options: [
                (text: "Благодарю за помощь!", next: Some("root"),
                    effect: [GiveGold(50), GiveItem(id: "health_potion", count: 2)]),
            ],
        ),

        // ============================================================
        // QUEST HUB
        // ============================================================
        "quest_hub": (
            speaker: "Elder",
            text: "Есть два дела. Первое — очистить лес от волков. Второе — открыть путь к цитадели. Что выберешь?",
            options: [
                (text: "Дай мне волков.", next: Some("quest_wolves_confirm"), effect: []),
                (text: "Расскажи про цитадель.", next: Some("quest_citadel_confirm"), effect: []),
                (text: "Я подумаю.", next: Some("root"), effect: []),
            ],
        ),
        "quest_wolves_confirm": (
            speaker: "Elder",
            text: "Убей пять волков на опушке. За это получишь золото и славу. По рукам?",
            options: [
                (text: "По рукам.", next: Some("quest_wolves_started"),
                    effect: [StartQuest("hunt_wolves")]),
                (text: "Сначала другое.", next: Some("quest_hub"), effect: []),
            ],
        ),
        "quest_wolves_started": (
            speaker: "Elder",
            text: "Отлично. Волки — у опушки, к востоку от деревни. Возвращайся с победой!",
            options: [
                (text: "Иду.", next: None, effect: []),
            ],
        ),
        "quest_citadel_confirm": (
            speaker: "Elder",
            text: "Найди ключ в сокровищнице — или пройди через портал кузнеца. Убей Владыку. Принесёшь его сердце — и я щедро награжу.",
            options: [
                (text: "Я справлюсь.", next: Some("quest_citadel_started"),
                    effect: [StartQuest("slay_lord")]),
                (text: "Сначала окрепну.", next: Some("quest_hub"), effect: []),
            ],
        ),
        "quest_citadel_started": (
            speaker: "Elder",
            text: "Пусть удача сопутствует тебе. Возвращайся живым.",
            options: [
                (text: "Обещаю.", next: None, effect: []),
            ],
        ),

        // ============================================================
        // RETURN — после квестов
        // ============================================================
        "return_thanks_wolves": (
            speaker: "Elder",
            text: "Ты сделал это! Волки больше не тревожат деревню. Возьми награду — ты заслужил.",
            options: [
                (text: "Рад помочь.", next: Some("root"),
                    effect: [GiveGold(200), GiveXp(100)]),
            ],
        ),
        "return_thanks_lord": (
            speaker: "Elder",
            text: "Владыка пал. Тьма отступила. Ты — герой, и легенды будут петь о тебе веками.",
            options: [
                (text: "Это было честью.", next: None,
                    effect: [GiveGold(1000), GiveXp(500)]),
            ],
        ),

        // ============================================================
        // JOKE / FLAVOR
        // ============================================================
        "joke": (
            speaker: "Elder",
            text: "Знаешь, почему волки не любят кузнеца? Потому что он слишком горячий собеседник!",
            options: [
                (text: "Ха-ха, неплохо.", next: Some("root"), effect: []),
                (text: "Я не понял.", next: Some("root"), effect: []),
            ],
        ),
    },
)